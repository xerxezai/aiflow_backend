{
  "_comment": "Soft-coded regex patterns per field. Each entry is a list of (pattern, flags, group, mode) where flags is a subset of ['IGNORECASE','MULTILINE','DOTALL'], group is the capturing-group index (1 by default), and mode is 'first' (return first hit) or 'all_csv' (return all unique hits joined by ','). Stop-words filter out obvious noise.",
  "version": "1.0",

  "patterns": {
    "area": [
      { "pattern": "\\bAREA\\s*[:\\-]\\s*([A-Z][A-Z0-9 _\\-]{2,40})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(PROCESS|UTILITIES?|UTILITY|OFFSITE[S]?|OFF[ -]SITES?|FLARE|STORAGE|COMPRESSION|SEPARATION|INJECTION|TREATMENT)\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" }
    ],

    "unit": [
      { "pattern": "\\bUNIT[-\\s#]*(?:NO\\.?)?\\s*([0-9]{1,4})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bU[-\\s]?0?([0-9]{2,3})\\b", "flags": [], "group": 1, "mode": "first" },
      { "pattern": "\\bACT(?:IVAT(?:E|ED|ION|ING)?|IVE|IVITY|V)?[-\\s]*UNIT\\s*[:\\-]?\\s*([0-9]{2,5}(?:\\s*[A-Z]\\s*[0-9]{1,2})?)\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bUNIT\\s+CODE\\s*[:\\-]?\\s*([0-9]{2,5}(?:\\s*[A-Z]\\s*[0-9]{1,2})?)\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bPLANT\\s+UNIT\\s*[:\\-]?\\s*([0-9]{2,5})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(7[0-9]{3}\\s*[A-Z]\\s*[0-9]{1,2})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" }
    ],

    "adnoc_project_no": [
      { "pattern": "\\bADNOC\\s+PROJECT\\s+(?:NO\\.?|NUMBER|#)\\s*[:\\-]?\\s*([A-Z0-9\\-/]{2,25})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bPROJECT\\s+(?:NO\\.?|NUMBER|CODE|#)\\s*[:\\-]?\\s*([A-Z0-9\\-/]{2,25})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" }
    ],

    "project_title": [
      { "pattern": "\\bPROJECT\\s+(?:TITLE|NAME)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9 &,\\-/()]{5,90})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(ONSHORE\\s+GAS\\s+DEVELOPMENT\\s+PROJECT|HABSHAN\\s+DEVELOPMENT|BAB\\s+FIELD\\s+DEVELOPMENT)\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" }
    ],

    "vendor_name": [
      { "pattern": "\\bVENDOR\\s*(?:NAME)?\\s*[:\\-]\\s*([A-Z0-9][A-Z0-9 &.,\\-/()']{2,70})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bMANUFACTURER\\s*[:\\-]\\s*([A-Z0-9][A-Z0-9 &.,\\-/()']{2,70})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bSUPPLIER\\s*[:\\-]\\s*([A-Z0-9][A-Z0-9 &.,\\-/()']{2,70})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bVENDOR\\s*(?:NAME)?\\s*[\\r\\n]+\\s*([A-Z][A-Z0-9 &.,\\-/()']{3,70})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bVENDOR\\s+([A-Z][A-Z]{2,}(?:\\s+[A-Z][A-Z0-9&.,\\-/()']*){0,6})\\b", "flags": [], "group": 1, "mode": "first" },
      { "pattern": "\\bMANUFACTURER\\s*[\\r\\n]+\\s*([A-Z][A-Z0-9 &.,\\-/()']{3,70})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bSUPPLIER\\s*[\\r\\n]+\\s*([A-Z][A-Z0-9 &.,\\-/()']{3,70})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(?:MFG|MANUFACTURED|MADE|SUPPLIED|FURNISHED)\\s+BY\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9 &.,\\-/()']{2,70})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bMAKE\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9 &.,\\-/()']{2,70})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bM\\s*/\\s*S\\.?\\s*([A-Z0-9][A-Z0-9 &.,\\-/()']{2,70})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(NUOVO\\s+PIGNONE|SNAMPROGETTI|TECNIMONT|FOSTER\\s+WHEELER|SAIPEM|TECHNIP|MITSUBISHI\\s+HEAVY|HITACHI|TOSHIBA|SIEMENS|ABB|GENERAL\\s+ELECTRIC|HONEYWELL|EMERSON|YOKOGAWA|FLOWSERVE|SULZER|EBARA|KSB|GRUNDFOS|ROSEMOUNT|FISHER|MASONEILAN|VELAN|CRANE)\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b([A-Z][A-Z &.,\\-']{3,60}\\s+(?:S\\.?P\\.?A\\.?|S\\.?R\\.?L\\.?|LLC|LIMITED|LTD|GMBH|INC|CORP|CO\\.?|COMPANY|B\\.?V\\.?|N\\.?V\\.?|A\\.?G\\.?|PVT))\\b", "flags": [], "group": 1, "mode": "first" }
    ],

    "po_no": [
      { "pattern": "\\bPURCHASE\\s+ORDER\\s*(?:NO\\.?|NUMBER|#)?\\s*[:\\-]\\s*([A-Z0-9][A-Z0-9\\-/]{4,30})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bP\\.O\\.\\s*(?:NO\\.?|NUMBER|#)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/]{4,30})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bP\\.O\\.\\s*[:\\-]\\s*([A-Z0-9][A-Z0-9\\-/]{4,30})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bPO\\s*(?:NO\\.?|NUMBER|#)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/]{4,30})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" }
    ],

    "contractor_ref": [
      { "pattern": "\\b(?:CONTRACTOR|EPC|MAIN\\s+CONTRACTOR)\\s+(?:DOC(?:UMENT)?\\s+)?(?:REF(?:ERENCE)?\\s+)?(?:NO\\.?|NUMBER|#)?\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/,]{4,60})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bDRAWING\\s*(?:NO\\.?|NUMBER|#)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/,_ ]{4,80})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bDR[GW]\\s*(?:NO\\.?|NUMBER|#)?\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/,_]{4,80})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bD\\.?W\\.?G\\.?\\s*(?:NO\\.?|NUMBER|#)?\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/,_]{4,80})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bDOC(?:UMENT)?\\s*(?:NO\\.?|NUMBER|#)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/,_]{4,80})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(7600L[\\- ]?[A-Z0-9\\-]{6,30})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "all_csv" },
      { "pattern": "\\b(NC[\\-_]\\d{2,3}[\\-_]\\d{2}[\\-_]\\d{2,4})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "all_csv" },
      { "pattern": "\\b(\\d{2,3}[\\-_]\\d{2,4}[\\-_]\\d{2,4}(?:[\\-_]\\d{2,4})?)\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "all_csv" }
    ],

    "vendor_ref": [
      { "pattern": "\\bVENDOR\\s+(?:DOC(?:UMENT)?\\s+)?(?:REF(?:ERENCE)?\\s+)?(?:NO\\.?|NUMBER|#)?\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/,]{4,60})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(DIS[\\-][A-Z0-9\\-]{4,30})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "all_csv" }
    ],

    "originator": [
      { "pattern": "\\b(?:FROM|ORIGINATOR|ISSUED\\s+BY|PREPARED\\s+BY)\\s*[:\\-]\\s*([A-Z0-9][A-Z0-9 &.,\\-/()']{2,70})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(BECHTEL[\\- ]?TECHNIP(?:\\s+JOINT\\s+VENTURE)?|BECHTEL\\s+LIMITED|BECHTEL|TECHNIP|SAIPEM|JGC|FLUOR|KENT|WOOD\\s+GROUP|WORLEY|PETROFAC|MCDERMOTT|GS\\s+ENGINEERING|HYUNDAI|SAMSUNG|DAEWOO|KBR|JACOBS|AKER|SNAMPROGETTI|CB&I|TOYO|SK\\s+ENGINEERING)\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" }
    ],

    "project_location": [
      { "pattern": "\\b(?:LOCATION|SITE|PLANT\\s+LOCATION)\\s*[:\\-]\\s*([A-Z][A-Z \\-]{2,40})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(HABSHAN|RUWAIS|DAS\\s+ISLAND|SAS\\s+AL\\s+NAKHL|ASAB|BAB|BU\\s+HASA|SHAH|DALMA|ZIRKU|MUSSAFAH|ABU\\s+DHABI)\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" }
    ],

    "author": [
      { "pattern": "\\bAUTHOR\\s*[:\\-]\\s*([A-Z0-9][A-Z0-9 &.,\\-/()']{2,60})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bPREPARED\\s+BY\\s*[:\\-]?\\s*([A-Z][A-Z &.,\\-']{2,60})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(?:DRAWN|DRAFTED|WRITTEN|ORIGINATED|DESIGNED|CREATED)\\s+BY\\s*[:\\-]?\\s*([A-Z][A-Z &.,\\-']{2,60})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(?:DRAWN|DRWN|DSGN|DESIGN|DESIGNED|PREPARED|CHECKED|CHKD|APPROVED|APPRVD|APPRD|ENGINEER|ENGG)\\s*[:\\-]\\s*([A-Z][A-Z &.,\\-']{2,40})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bAUTH(?:OR(?:ED)?)?\\.?\\s*BY\\s*[:\\-]?\\s*([A-Z][A-Z &.,\\-']{2,60})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(?:NAME|INITIAL|SIGN(?:ED)?)\\s*[:\\-]\\s*([A-Z][A-Z &.,\\-']{2,40})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(BECHTEL[\\- ]?TECHNIP(?:\\s+JOINT\\s+VENTURE)?|BECHTEL\\s+LIMITED|BECHTEL|TECHNIP|SAIPEM|JGC|FLUOR|KENT|WOOD\\s+GROUP|WORLEY|PETROFAC|MCDERMOTT|GS\\s+ENGINEERING|HYUNDAI|SAMSUNG|DAEWOO|KBR|JACOBS|AKER|SNAMPROGETTI|CB&I|TOYO|SK\\s+ENGINEERING)\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" }
    ],

    "agreement_no": [
      { "pattern": "\\bAGREEMENT\\s+(?:NO\\.?|NUMBER|#|REF(?:ERENCE)?)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/]{2,30})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bCONTRACT\\s+(?:NO\\.?|NUMBER|#|REF(?:ERENCE)?)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/]{2,30})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(?:AGRMT|AGRMNT|AGRMT\\s+NO|AGRMNT\\s+NO|AGREEMT)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/]{2,30})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(?:CONTRACT|AGREEMENT)\\s+ID\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/]{2,30})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bAGREEMENT\\s*[:\\-]\\s*([A-Z0-9][A-Z0-9\\-/]{2,30})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bP[OQ]\\s+(?:NO|NUMBER|#)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/]{4,25})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bFA\\s*(?:NO|NUMBER|#)?\\s*[:\\-]?\\s*([0-9]{5,12})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(?:FRAME(?:WORK)?\\s+AGREEMENT)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/]{2,30})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" }
    ],

    "agreement_desc": [
      { "pattern": "\\bAGREEMENT\\s+(?:DESC(?:RIPTION)?|TITLE|NAME|SUBJECT)\\s*[:\\-]\\s*([A-Z0-9][A-Z0-9 &.,\\-/()']{3,120})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bCONTRACT\\s+(?:DESC(?:RIPTION)?|TITLE|NAME|SUBJECT)\\s*[:\\-]\\s*([A-Z0-9][A-Z0-9 &.,\\-/()']{3,120})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(?:CONTRACT|AGREEMENT)\\s+SCOPE\\s*[:\\-]\\s*([A-Z0-9][A-Z0-9 &.,\\-/()']{3,120})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bSCOPE\\s+OF\\s+WORK\\s*[:\\-]\\s*([A-Z0-9][A-Z0-9 &.,\\-/()']{3,120})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" }
    ],

    "class_review": [
      { "pattern": "\\b(?:CLASS(?:IFICATION)?|REVIEW\\s+CODE|CRS\\s+CODE|CRC|REVIEW\\s+CLASS)\\s*[:\\-]\\s*([A-Z0-9][A-Z0-9\\-/]{0,15})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bCLASS\\s+OF\\s+REVIEW\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/]{0,15})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bREVIEW\\s+CATEGORY\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/]{0,15})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bDOC(?:UMENT)?\\s+CLASS\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/]{0,15})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(?:RC|CR|CRC)\\s*CODE\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/]{0,10})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(?:^|[\\s,])CLASS\\s*[:\\-]\\s*([1-4]|I{1,3}V?|[A-D])\\b", "flags": ["IGNORECASE", "MULTILINE"], "group": 1, "mode": "first" },
      { "pattern": "\\bREVIEW\\s+CODE\\s*[:\\-]?\\s*([1-4]|[A-D]|I{1,3}V?)\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" }
    ],

    "transmittal_no": [
      { "pattern": "\\bTRANSMITTAL\\s+(?:NO\\.?|NUMBER|#|REF(?:ERENCE)?)\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/]{3,40})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\b(?:TRANSMITTAL|XMITTAL|XMIT)\\s*[:\\-]\\s*([A-Z0-9][A-Z0-9\\-/]{3,40})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bDOC(?:UMENT)?\\s+TRANSMITTAL\\s*(?:NO\\.?|NUMBER|#)?\\s*[:\\-]?\\s*([A-Z0-9][A-Z0-9\\-/]{3,40})", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bTR[\\- ]?([0-9]{4,10})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bDTN[\\- ]?([A-Z0-9\\-]{4,30})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bMDT[\\- ]?([A-Z0-9\\-]{4,30})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" },
      { "pattern": "\\bTRN[\\- ]?([A-Z0-9\\-]{4,30})\\b", "flags": ["IGNORECASE"], "group": 1, "mode": "first" }
    ]
  },

  "_comment_stop_words": "Values that look like matches but are noise. Comparison is case-insensitive.",
  "stop_words": [
    "NA", "N/A", "TBD", "TBA", "XXX", "XXXX", "NONE",
    "DOCUMENT", "DOCUMENTS", "REVISION", "DATE", "PAGE", "SHEET",
    "NUMBER", "NO", "TITLE", "CODE", "CLASS", "REVIEW", "AGREEMENT",
    "CONTRACT", "TRANSMITTAL", "AUTHOR", "BY", "NAME"
  ]
}
