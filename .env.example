# ============================================
# AIFlow Environment Variables Template
# ============================================
# SECURITY: Copy this file to .env and fill in your actual credentials
# NEVER commit .env file to git - it contains secrets!
# ============================================

# Django Configuration
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_NAME=radai_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=db
DB_PORT=5432

# AWS Credentials (REQUIRED for S3 access)
# ⚠️ SECURITY: Never hardcode these in Python files!
# Get from: AWS Console → IAM → Users → Security Credentials
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=your-region

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Redis Configuration (for Celery)
REDIS_HOST=redis
REDIS_PORT=6379

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-email-password

# Railway Production Settings (Optional)
# DATABASE_URL=postgresql://user:pass@host:port/dbname
# S3_READY=False

# ── Production → Local DB Sync ──────────────────────────────────────────────
# Public connection URL to the Railway production PostgreSQL.
# Used exclusively by: python manage.py sync_from_production
# Get it with: railway variables --service Postgres --json
# Then copy the value of DATABASE_PUBLIC_URL below.
# NEVER set this in production — local dev only.
PROD_DATABASE_URL=postgresql://postgres:<password>@<public-host>:<port>/railway

# Optional tuning for sync_from_production:
# SYNC_BATCH_SIZE=500          # rows per INSERT batch (default: 500)
# SYNC_DEFAULT_MODE=incremental # full | incremental (default: incremental)

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
