  "_engineering_rule_library": {
    "_comment": "SOFT-CODED engineering rules derived from project QC reviews and process engineering standards. All entries here feed future rule development. Edit without code change.",

    "RED-001": {
      "id": "RED-001",
      "short": "Red-colored annotation detected",
      "desc": "In P&ID practice, red-colored text marks revision additions, HOLD items, scope clouds, and design pressure/temperature exceptions. Every red annotation must be traceable to the current revision record.",
      "pattern_examples": [
        "H @ 65 bar",
        "2\" - VG-6156-033842-X-N  (entire line designation in red = new line in this revision)",
        "18\" (size annotation in red = revised size or scope-cloud item)",
        "HOLD 3",
        "REV 1"
      ],
      "severity": "major",
      "action": "Verify each red annotation is covered by the revision documentation. Resolve HOLDs. Confirm scope-cloud items are in the MTO and IFC package."
    },

    "VLV-002": {
      "id": "VLV-002",
      "short": "Globe valve oversized",
      "desc": "Globe valves are limited in practical NPS because of body pressure drop and physical weight. Above NPS 16\" it is nearly impossible to specify a globe valve from standard vendor catalogues. 30\" globe valve is an extreme engineering anomaly — almost certainly a drawing annotation error or wrong valve selection.",
      "typical_max_nps_inch": 16,
      "pattern_examples": [
        "30\" GLOBE VALVE",
        "3\" GLOBE VALVE (valid — 3\" is a standard size)"
      ],
      "severity": "critical",
      "action": "Verify valve type: consider gate valve (NPS ≤ 24\") or butterfly valve (NPS ≥ 6\") for large bore applications. Confirm with piping engineer and valve vendor."
    },

    "VLV-003": {
      "id": "VLV-003",
      "short": "Control valve oversized",
      "desc": "Control valves above NPS 16\" require individual hydraulic sizing and extended delivery lead times. A 16\" distributed control valve for PI-3610 is at the upper edge; verify with process calculations.",
      "typical_max_nps_inch": 16,
      "pattern_examples": [
        "PI-3610 16 in Distributed Control Valve",
        "16\" CONTROL VALVE"
      ],
      "severity": "major",
      "action": "Submit control valve data sheet to vendor for individual sizing confirmation. Cross-check with process simulation flow rates."
    },

    "LSZ-011": {
      "id": "LSZ-011",
      "short": "Extreme reducer ratio",
      "desc": "A NxM reducer annotation has a size ratio exceeding 2.5:1. Standard process plant practice recommends a maximum single-step reduction of 2:1 (e.g. 6\"x3\") in most piping classes to avoid high local velocities and excessive pressure drop.",
      "max_ratio": 2.5,
      "pattern_examples": [
        "6\"x2\" (ratio 3:1 — flags) — 6\" inlet, 2\" outlet, extreme reduction",
        "6\"x4\" (ratio 1.5:1 — OK)",
        "8\"x3\" (ratio 2.67:1 — flags)"
      ],
      "severity": "major",
      "action": "Verify the reducer ratio with the piping stress engineer. Consider two in-series reducers if project spec mandates max 2:1. Cross-check with fluid velocity calculations."
    },

    "LSZ-012": {
      "id": "LSZ-012",
      "short": "Equipment size annotation mismatch",
      "desc": "A size annotation sits directly adjacent to an equipment keyword (VORTEX BREAKER, IMPINGEMENT PLATE, etc.) but the stated NPS does not match any line designation extracted from the drawing.",
      "pattern_examples": [
        "20\" in VORTEX BREAKER (no 20\" line tag extracted)",
        "18\" IMPINGEMENT PLATE"
      ],
      "severity": "major",
      "action": "Verify equipment nozzle connection size matches the connected pipe. If the line designation was not extracted by OCR, check for non-standard label format or re-run at higher DPI."
    },

    "ANN-001": {
      "id": "ANN-001",
      "short": "Pressure annotation check",
      "desc": "A pressure annotation of the form '{class} @ {N} bar' was detected. For Mubarraz project, typical design pressure is 20–80 barg for most process systems. Annotations exceeding 50 bar require explicit piping class (PMC) verification.",
      "threshold_bar": 50,
      "pattern_examples": [
        "H @ 65 bar — heat-traced line at 65 barg: confirm PMC covers 65 bar",
        "P @ 120 bar — personnel protection at 120 barg: safety-critical check",
        "@ 65 bar — standalone pressure callout near a nozzle or valve"
      ],
      "severity_above_threshold": "critical",
      "severity_below_threshold": "info",
      "action": "Cross-check stated pressure against the relevant Piping Material Class (PMC). Confirm all valves, instruments, and flanges on the annotated line are rated to the stated pressure."
    },

    "_scope_cloud_patterns": {
      "_comment": "Patterns observed inside P&ID scope/revision clouds — used by both RED-001 and visual inspection. Add new patterns here for future rule extension.",
      "observed_in_revision_1": [
        "18\" (large pipe in scope — new addition or revised size)",
        "6\"x2\" (reducer in scope — new connection or changed spec)",
        "2\" - VG-6156-033842-X-N (new vent gas line added in this revision)"
      ],
      "interpretation": "Items inside revision clouds are added, modified, or deleted in the stated revision. Verify each item against the revision change register."
    },

    "_valve_type_size_reference": {
      "_comment": "Engineering reference table for typical maximum NPS by valve type. Used to set VLV-002 and VLV-003 thresholds.",
      "GLOBE": {
        "practical_max_nps_inch": 16,
        "reason": "High pressure drop (velocity-head loss), excessive body weight above NPS 16\", limited vendor availability",
        "alternatives_above_max": ["Gate valve", "Ball valve", "Butterfly valve"]
      },
      "GATE": {
        "practical_max_nps_inch": 60,
        "reason": "Gate valves are the standard choice for large bore isolation up to NPS 60\" in API 600 / API 602"
      },
      "BALL": {
        "practical_max_nps_inch": 60,
        "reason": "Full-bore ball valves can be manufactured up to NPS 60\" for large isolation"
      },
      "BUTTERFLY": {
        "practical_min_nps_inch": 4,
        "practical_max_nps_inch": 120,
        "reason": "Butterfly valves are the primary choice for large bore (> NPS 6\") low-pressure isolation"
      },
      "CHECK": {
        "practical_max_nps_inch": 60,
        "reason": "Swing-type check valves available up to NPS 60\""
      },
      "CONTROL": {
        "practical_max_nps_inch": 16,
        "reason": "Individual hydraulic sizing required above NPS 16\"; lead times are 20–40 weeks for large bore"
      }
    }
  }
