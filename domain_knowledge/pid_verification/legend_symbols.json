  "line_numbering_validation_rules": {
    "_comment": "Rules for validating line designations found on P&IDs — all soft-coded. Used by rule engine.",
    "LN-001": {
      "id": "LN-001",
      "short": "Invalid service code",
      "desc": "Line designation uses a service identifier not in the project service code registry.",
      "severity": "major",
      "action": "Verify service code against PJ6-EXD-GEN-BQDA-0002 Sheet 001 Line Numbering System and correct."
    },
    "LN-002": {
      "id": "LN-002",
      "short": "Invalid insulation class",
      "desc": "Line designation suffix uses an insulation class letter other than C, H, P, or T.",
      "severity": "minor",
      "action": "Correct insulation class to C (cold), H (heat), P (personnel), or T (tracing) per project legend."
    },
    "LN-003": {
      "id": "LN-003",
      "short": "Non-standard NPS size",
      "desc": "Pipe size (NPS) in line designation is not a standard nominal pipe size.",
      "severity": "minor",
      "action": "Confirm pipe size against piping specification; update line designation if incorrect."
    },
    "LN-004": {
      "id": "LN-004",
      "short": "Sequence number format error",
      "desc": "Sequence number field in line designation has an unexpected length (should be 6-8 digits for Mubarraz project).",
      "severity": "minor",
      "action": "Verify sequencing per Document Numbering Procedure PJ6-DF-CM-NZ0F-1001."
    }
  },

